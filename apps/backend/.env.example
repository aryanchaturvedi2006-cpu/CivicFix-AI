# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Client & CORS
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database (Prisma)
DATABASE_URL=postgresql://civicfix:civicfix_secret@localhost:5432/civicfix_db?schema=public

# Authentication & Security
JWT_ACCESS_SECRET=civicfix_access_jwt_super_secret_key_at_least_32_chars_long
JWT_REFRESH_SECRET=civicfix_refresh_jwt_super_secret_key_at_least_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7
BCRYPT_SALT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# AI Microservice (FastAPI)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=3000

# Storage
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
